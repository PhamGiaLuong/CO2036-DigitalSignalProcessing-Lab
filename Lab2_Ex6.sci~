n = -1:3;
x1_pad = [0, 0, 1, 3, -2];
x2_pad = [0, 1, 2, 3, 0];
y_n = x1_pad + x2_pad;

// Plot x1(n)
subplot(3,1,1); 
plot2d3(n, x1_pad, style=2);
plot2d(n, x1_pad, style=-9);
xgrid();
title("Signal x1(n)", "fontsize", 3); 
xlabel("n"); ylabel("Amplitude");
a = gca(); a.data_bounds = [-2, -3; 4, 6]; 
// Plot x2(n)
subplot(3,1,2); 
plot2d3(n, x2_pad, style=3);
plot2d(n, x2_pad, style=-9); 
xgrid();
title("Signal x2(n)", "fontsize", 3); 
xlabel("n"); ylabel("Amplitude");
a = gca(); a.data_bounds = [-2, -3; 4, 6];
// Plot y(n)
subplot(3,1,3); 
plot2d3(n, y_n, style=5); 
plot2d(n, y_n, style=-9); 
xgrid();
title("y(n) = x1(n) + x2(n)", "fontsize", 3); 
xlabel("n"); ylabel("Amplitude");
a = gca(); a.data_bounds = [-2, -3; 4, 6];
